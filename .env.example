# Copy to .env and fill in. Never commit .env (it is gitignored).
# Offline (docker-compose.fake.yml) runs without any of these.
# Live (docker-compose.yml) refuses to start until the required ones are set.
# Generate secrets with: openssl rand -base64 32

# Login for the web page. Live: required, password at least 12 characters.
APP_USER=
APP_PASSWORD=

# Postgres and the Odoo admin user. Live: required.
POSTGRES_PASSWORD=
ODOO_ADMIN_PASSWORD=
ODOO_DB=writers

# How often the app polls Odoo for writes (seconds).
POLL_SECONDS=30

# Shopify (live only; offline the fake Shopify fills these in). The observer app
# receives webhooks; its client secret also signs them, so set both to the same value.
SHOPIFY_STORE=your-dev-store.myshopify.com
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_WEBHOOK_SECRET=

# LLM triage (Phase 3). Without a key the app still works, with triage off.
ANTHROPIC_API_KEY=
TRIAGE_MODEL_SMALL=claude-haiku-5-5
TRIAGE_MODEL_LARGE=claude-sonnet-5-5
